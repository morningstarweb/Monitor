# Preserve line endings
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.iss text eol=crlf

# Mark vendored third-party runtimes, redistributables, and test suites
# This ensures GitHub Linguist accurately reflects the core project languages (Kotlin & Rust)
installer/tools/** linguist-vendored
installer/redist/** linguist-vendored
tests/** linguist-vendored
scripts/** linguist-vendored
docs/** linguist-documentation
